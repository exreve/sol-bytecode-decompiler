				"aliases": ["verify_signatures", "VerifySignatures", "verify_signature", "tag_7", "tag 7", "instruction 7", "ix 7"],
				"accounts": ["instruction_acc", "instructions sysvar", "instruction sysvar", "sysvar", "accounts[3]", "account 3", "account #3", "4th account"],
				"keywords": ["sysvar", "instructions sysvar", "load_instruction_at", "secp256k1", "address", "spoof", "fake", "not checked", "unchecked", "Sysvar1nstructions"],
				"description": "verify_signatures reads the secp256k1 signature-verification instruction through the instructions sysvar (solana_program::sysvar::instructions::load_instruction_at) from account 3 (instruction_acc) without checking that its key is the Instructions sysvar id. An attacker passes a fake account holding a forged instruction list, so guardian signatures are marked verified without any secp256k1 verification; the forged signature set then posts a VAA that mints 120k wETH."
			},
