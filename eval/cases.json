{
	"about": "Ground truth for the reviewer eval (see eval/README.md). Never hand this file, eval/bin/ or eval/build.sh to a reviewer: a reviewer gets one eval/packets/<prog_NN>/<code|full>/ directory only. 'packets' maps each neutral packet id to its binary; a finding on a 'fixed' packet at the ground-truth location is a false positive.",
	"categories": {
		"missing-signer": "a privileged action does not require the authority to sign",
		"missing-owner-check": "account data is trusted without checking the account's owner program",
		"account-confusion": "an account is not bound to the other accounts / state it must belong to (has_one, stored key, PDA)",
		"sysvar-unchecked": "a sysvar is read from an account whose address is not checked",
		"unchecked-cpi-program": "a CPI goes to a program id taken from an account that is not checked",
		"remaining-account-unchecked": "an account passed in remaining_accounts is used without checking its address",
		"reinitialization": "an already-initialized account can be initialized again",
		"type-confusion": "an account of another type (or unchecked data) is deserialized as the expected type",
		"pda-bump": "a PDA is derived with a caller-supplied bump",
		"input-validation": "an instruction argument / derived amount is not range-checked (zero, bounds)",
		"arithmetic": "rounding / overflow / underflow in value computations"
	},
